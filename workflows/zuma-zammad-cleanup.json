{
  "name": "Zuma demo – weekly Zammad cleanup",
  "nodes": [
    {
      "name": "Sunday 05:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 5 * * 0"
            }
          ]
        }
      },
      "id": "27193a22-189a-4864-9908-a625b31ee13c"
    },
    {
      "name": "Run Zammad cleanup",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "authentication": "privateKey",
        "command": "python3 <path-to>/zuma-zammad-cleanup.py --apply 2>&1"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "REPLACE_ME",
          "name": "SSH Private Key - Docker Host"
        }
      },
      "id": "dee08928-aefd-4678-a29b-13101bef000f"
    }
  ],
  "connections": {
    "Sunday 05:00": {
      "main": [
        [
          {
            "node": "Run Zammad cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Indiana/Indianapolis",
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_ME"
  }
}
